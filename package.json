{
  "name": "@animeshmitra08/react-native-ui-kit",
  "version": "1.0.0",
  "description": "A reusable React Native UI component library",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && tsc -p tsconfig.dts.json && rollup -c rollup.dts.config.mjs && rimraf .dts-tmp",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist",
    "prepare": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Animeshmitra08/expo-ui.git"
  },
  "bugs": {
    "url": "https://github.com/Animeshmitra08/expo-ui/issues"
  },
  "homepage": "https://github.com/Animeshmitra08/expo-ui#readme",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "keywords": [
    "react-native",
    "ui",
    "components",
    "kit"
  ],
  "author": "Animeshmitra08",
  "license": "MIT",
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-native": ">=0.72.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@typescript/typescript6": "^6.0.2",
    "dts-bundle-generator": "^9.5.1",
    "react": "^19.1.0",
    "react-native": "^0.88.1",
    "rimraf": "^6.1.3",
    "rollup": "^4.66.0",
    "rollup-plugin-dts": "^6.5.1",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
